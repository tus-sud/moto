@model MotoShopWeb.Models.DonHang
@using MotoShopWeb.ViewModels
@{ViewData["Title"]="Đơn #"+Model.MaDonHang;}
<section class="wrap section"><a asp-action="Index">← Đơn của tôi</a><h1 class="page-title">Yêu cầu #@Model.MaDonHang</h1><p class="badge">@OrderLabels.Name(Model.TrangThai)</p><div class="checkout-grid"><div class="panel"><h2>Thông tin yêu cầu</h2>
@foreach(var line in Model.ChiTietDonHangs){<p><strong>@line.MauXe.MaXeNavigation.TenXe</strong><br />@line.MauXe.TenMau × @line.SoLuong · @((line.DonGia*line.SoLuong).ToString("N0")) ₫</p>}
<h3>Tổng ghi nhận: @Model.TongTien.ToString("N0") ₫</h3><p>@Model.TenNguoiNhan · @Model.SdtnguoiNhan</p><p>@Model.DiaChiGiao</p><p class="muted">Đây là yêu cầu mua xe, không phải biên nhận thanh toán. Cửa hàng sẽ liên hệ xác nhận.</p>
<div class="actions" style="margin-top:16px">
<a class="button" asp-action="Invoice" asp-route-id="@Model.MaDonHang">Xem Thanh toán &amp; Hóa đơn bảo hành →</a>
@if(Model.TrangThai=="ChoXacNhan"){<form asp-action="Cancel" method="post" style="margin:0"><input type="hidden" name="id" value="@Model.MaDonHang" /><button type="submit" class="button" style="background:#fff0ee;color:#9d2020;border:1px solid #f2c4bc">Hủy yêu cầu mua xe</button></form>}
</div>
</div>
<aside class="panel"><h2>Tiến trình</h2>@foreach(var item in Model.LichSuDonHangs.OrderByDescending(x=>x.ThoiGian)){<p><strong>@OrderLabels.Name(item.TrangThai)</strong><br /><small>@item.ThoiGian.ToString("dd/MM/yyyy HH:mm")</small><br />@item.GhiChu</p>}</aside></div></section>
