@model MotoShopWeb.ViewModels.CheckoutForm
@{
    ViewData["Title"] = "Thông tin nhận xe, Bảo hành & Thanh toán";
    var bikesSubtotal = Model.Lines.Sum(x => x.Total);
}
<section class="wrap section">
    <p class="eyebrow">01 CHỌN XE &amp; MÀU ✓ &nbsp;/&nbsp; <strong>02 THÔNG TIN &amp; BẢO HÀNH</strong> &nbsp;/&nbsp; 03 THANH TOÁN &amp; HÓA ĐƠN</p>
    <h1 class="page-title" style="margin:10px 0 28px">Hoàn tất thông tin &amp; Chọn gói bảo hành</h1>

    <form method="post" class="checkout-grid" id="checkoutForm">
        <div style="display:flex;flex-direction:column;gap:24px">
            <div class="panel form-stack">
                <div asp-validation-summary="All" class="validation" role="alert"></div>
                <input asp-for="Token" type="hidden" />

                <h2 style="margin-top:0">1. Thông tin người nhận xe</h2>
                <div class="auth-row">
                    <div class="auth-field">
                        <label asp-for="Name">Họ và tên người nhận</label>
                        <input asp-for="Name" placeholder="Nguyễn Văn A" autocomplete="name" required maxlength="100" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Phone">Số điện thoại liên hệ</label>
                        <input asp-for="Phone" type="tel" placeholder="09xx xxx xxx" autocomplete="tel" required maxlength="11" />
                        <span asp-validation-for="Phone" class="field-error"></span>
                    </div>
                </div>

                <div class="auth-field">
                    <label asp-for="Address">Địa chỉ nhận xe (hoặc nhận tại Showroom)</label>
                    <textarea asp-for="Address" autocomplete="street-address" required maxlength="255" rows="2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="CustomerNote">Ghi chú thêm cho cửa hàng (tùy chọn)</label>
                    <input asp-for="CustomerNote" placeholder="Ví dụ: Giao xe giờ hành chính, hỗ trợ đăng ký biển số..." maxlength="300" />
                </div>
            </div>

            <div class="panel form-stack">
                <div>
                    <h2 style="margin:0 0 6px">2. Chọn gói bảo hành &amp; đặc quyền dịch vụ</h2>
                    <p class="muted" style="margin:0;font-size:14px">Tick vào từng gói bảo hành bên dưới để xem đầy đủ <strong>chính sách bảo hành, thời hạn, quyền lợi và điều kiện áp dụng</strong>.</p>
                </div>

                <div class="warranty-list">
                    @foreach (var w in Model.WarrantyOptions)
                    {
                        var isChecked = Model.SelectedWarrantyIds.Contains(w.Id);
                        <div class="warranty-card @(isChecked ? "is-selected" : "")" data-warranty-card>
                            <label class="warranty-head">
                                <input type="checkbox"
                                       name="SelectedWarrantyIds"
                                       value="@w.Id"
                                       checked="@isChecked"
                                       data-warranty-checkbox
                                       data-price="@w.Price"
                                       data-name="@w.Name" />
                                <div class="warranty-head-main">
                                    <div class="warranty-title-row">
                                        <strong>@w.Name</strong>
                                        <span class="warranty-badge">@w.Badge</span>
                                    </div>
                                    <p class="warranty-summary">@w.Summary</p>
                                    <div class="warranty-meta-tags">
                                        <span>⏱ Thời hạn: <strong>@w.Months tháng</strong></span>
                                        <span>🛣 Giới hạn: <strong>@(w.MaxKm >= 99999 ? "Không giới hạn km" : $"{w.MaxKm:N0} km")</strong></span>
                                        <span>Mã gói: <code>@w.Code</code></span>
                                    </div>
                                </div>
                                <div class="warranty-price">
                                    @(w.Price == 0 ? "Miễn phí" : "+" + w.Price.ToString("N0") + " ₫")
                                </div>
                            </label>

                            <div class="warranty-details" data-warranty-details @(isChecked ? "" : "hidden")>
                                <div class="warranty-policy-box">
                                    <h4>Chính sách bảo hành chi tiết</h4>
                                    <p>@w.PolicyDetails</p>

                                    <h4>Quyền lợi khách hàng được hưởng</h4>
                                    <ul class="warranty-benefits">
                                        @foreach (var b in w.Benefits)
                                        {
                                            <li><span>✓</span> <div>@b</div></li>
                                        }
                                    </ul>

                                    <div class="warranty-condition">
                                        <strong>Điều kiện &amp; Phạm vi áp dụng:</strong> @w.Conditions
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="panel form-stack">
                <h2 style="margin:0 0 6px">3. Hình thức &amp; Phương thức thanh toán</h2>
                <p class="muted" style="margin:0 0 8px;font-size:14px">Chọn phương án thanh toán phù hợp để hệ thống lập Hóa đơn đặt xe cho bạn.</p>

                <div class="auth-row">
                    <div class="auth-field">
                        <label asp-for="PaymentPlan">Hình thức thanh toán</label>
                        <select asp-for="PaymentPlan" id="paymentPlanSelect">
                            <option value="DatCoc">Đặt cọc giữ xe (10.000.000 ₫)</option>
                            <option value="ThanhToanDu">Thanh toán 100% tổng giá trị hóa đơn</option>
                            <option value="TaiShowroom">Thanh toán trực tiếp tại Showroom khi nhận xe</option>
                        </select>
                    </div>
                    <div class="auth-field">
                        <label asp-for="PaymentMethod">Phương thức giao dịch</label>
                        <select asp-for="PaymentMethod">
                            <option value="Chuyển khoản ngân hàng (VietQR)">Chuyển khoản ngân hàng (Mã VietQR)</option>
                            <option value="Thẻ ATM / Visa / Mastercard">Thẻ ATM nội địa / Visa / Mastercard</option>
                            <option value="Trả góp qua công ty tài chính">Hỗ trợ trả góp (Thẻ tín dụng / Tài chính)</option>
                            <option value="Tiền mặt tại quầy Showroom">Tiền mặt tại quầy Showroom</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <aside class="panel" style="position:sticky;top:100px">
            <p class="eyebrow">TÓM TẮT ĐƠN ĐẶT XE</p>
            <h2 style="margin-top:6px">Chi tiết tạm tính</h2>

            <div style="display:flex;flex-direction:column;gap:12px;border-bottom:1px solid var(--line);padding-bottom:16px">
                @foreach (var line in Model.Lines)
                {
                    <div style="display:flex;justify-content:space-between;gap:12px">
                        <div>
                            <strong>@line.Name</strong>
                            <div class="muted" style="font-size:13px">Màu: @line.Color × @line.Quantity</div>
                        </div>
                        <strong style="white-space:nowrap">@line.Total.ToString("N0") ₫</strong>
                    </div>
                }
            </div>

            <div style="display:flex;flex-direction:column;gap:10px;padding:16px 0;border-bottom:1px solid var(--line);font-size:14.5px">
                <div style="display:flex;justify-content:space-between">
                    <span class="muted">Giá xe niêm yết:</span>
                    <strong id="bikesSubtotalText" data-subtotal="@bikesSubtotal">@bikesSubtotal.ToString("N0") ₫</strong>
                </div>
                <div style="display:flex;justify-content:space-between">
                    <span class="muted">Phí gói bảo hành đã chọn:</span>
                    <strong id="warrantyTotalText">0 ₫</strong>
                </div>
                <div id="selectedWarrantyNames" class="muted" style="font-size:12.5px;line-height:1.5"></div>
            </div>

            <div style="padding:16px 0">
                <div style="display:flex;justify-content:space-between;align-items:baseline">
                    <span>Tổng giá trị hóa đơn:</span>
                    <strong id="grandTotalText" style="font-size:24px;color:#176143">@bikesSubtotal.ToString("N0") ₫</strong>
                </div>
                <div style="display:flex;justify-content:space-between;margin-top:8px;padding:10px 12px;background:#eef4e6;border-radius:8px;font-size:14px">
                    <span>Cần thanh toán bước tiếp theo:</span>
                    <strong id="payableNowText">10.000.000 ₫</strong>
                </div>
            </div>

            <button class="button auth-submit" type="submit">
                <span>Tiếp tục tới Thanh toán &amp; Hóa đơn</span>
                <span aria-hidden="true">→</span>
            </button>

            <div style="margin-top:14px;display:flex;justify-content:space-between;font-size:13px">
                <a asp-action="Index">← Sửa giỏ hàng</a>
                <a asp-action="Checkout">Làm mới giá</a>
            </div>
        </aside>
    </form>
</section>

@section Scripts {
<script>
(() => {
    const subtotalEl = document.getElementById("bikesSubtotalText");
    const warrantyTotalEl = document.getElementById("warrantyTotalText");
    const warrantyNamesEl = document.getElementById("selectedWarrantyNames");
    const grandTotalEl = document.getElementById("grandTotalEl") || document.getElementById("grandTotalText");
    const payableNowEl = document.getElementById("payableNowText");
    const planSelect = document.getElementById("paymentPlanSelect");
    const checkboxes = Array.from(document.querySelectorAll("[data-warranty-checkbox]"));
    const fmt = new Intl.NumberFormat("vi-VN");

    function updateSummary() {
        const subtotal = Number(subtotalEl?.dataset.subtotal || 0);
        let warrantySum = 0;
        const names = [];

        checkboxes.forEach(cb => {
            const card = cb.closest("[data-warranty-card]");
            const details = card?.querySelector("[data-warranty-details]");
            if (cb.checked) {
                card?.classList.add("is-selected");
                if (details) details.hidden = false;
                warrantySum += Number(cb.dataset.price || 0);
                names.push("• " + cb.dataset.name);
            } else {
                card?.classList.remove("is-selected");
                if (details) details.hidden = true;
            }
        });

        const grandTotal = subtotal + warrantySum;
        if (warrantyTotalEl) warrantyTotalEl.textContent = warrantySum === 0 ? "0 ₫ (Miễn phí)" : "+" + fmt.format(warrantySum) + " ₫";
        if (warrantyNamesEl) warrantyNamesEl.innerHTML = names.length ? names.join("<br/>") : "• Mặc định áp dụng Bảo hành Tiêu chuẩn Chính hãng (0 ₫)";
        if (grandTotalEl) grandTotalEl.textContent = fmt.format(grandTotal) + " ₫";

        if (payableNowEl && planSelect) {
            const plan = planSelect.value;
            if (plan === "DatCoc") {
                payableNowEl.textContent = fmt.format(Math.min(10000000, grandTotal)) + " ₫ (Đặt cọc)";
            } else if (plan === "ThanhToanDu") {
                payableNowEl.textContent = fmt.format(grandTotal) + " ₫ (100%)";
            } else {
                payableNowEl.textContent = "0 ₫ (Thanh toán tại Showroom)";
            }
        }
    }

    checkboxes.forEach(cb => cb.addEventListener("change", updateSummary));
    planSelect?.addEventListener("change", updateSummary);
    updateSummary();
})();
</script>
}
