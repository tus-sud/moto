@model List<MotoShopWeb.Models.DonHang>
@using MotoShopWeb.ViewModels
@{ViewData["Title"]="Yêu cầu mua xe";}
<h1>Yêu cầu mua xe</h1><p>Xem thông tin khách và liên hệ xác nhận trước khi xử lý. Mỗi trang tối đa 20 đơn.</p>
<div class="panel" style="overflow:auto"><table><thead><tr><th>Mã đơn</th><th>Ngày gửi</th><th>Khách nhận</th><th>Điện thoại</th><th>Tổng ghi nhận</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var order in Model){<tr><td>#@order.MaDonHang</td><td>@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</td><td>@order.TenNguoiNhan</td><td>@order.SdtnguoiNhan</td><td>@order.TongTien.ToString("N0") ₫</td><td>@OrderLabels.Name(order.TrangThai)</td><td><a asp-action="Details" asp-route-id="@order.MaDonHang">Xem chi tiết →</a></td></tr>}
</tbody></table>@if(Model.Count==0){<p>Chưa có đơn hàng trên trang này.</p>}</div><p>@if(ViewBag.Page>1){<a asp-route-page="@(ViewBag.Page-1)">← Trước</a>} · Trang @ViewBag.Page · @if(Model.Count==20){<a asp-route-page="@(ViewBag.Page+1)">Tiếp →</a>}</p>
