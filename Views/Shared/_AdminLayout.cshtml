@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · MotoShop Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/password-eye.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <a class="brand" asp-controller="Admin" asp-action="Index">MOTO<span>SHOP</span><small>TRUNG TÂM QUẢN TRỊ</small></a>
        <div class="nav-label">ĐIỀU HÀNH</div>
        <nav>
            <a asp-controller="Admin" asp-action="Index">Tổng quan</a>
            <a asp-controller="Admin" asp-action="Vehicles">Quản lý xe</a>
            <a asp-controller="Workspace" asp-action="Vehicles">Khu làm việc xe</a>
            <a asp-controller="Admin" asp-action="Catalog">Hãng &amp; loại xe</a>
            <a asp-controller="Admin" asp-action="Employees">Nhân viên &amp; phân quyền</a>
            <a asp-controller="OrdersAdmin" asp-action="Index">Yêu cầu mua xe</a>
            <a asp-controller="TestRide" asp-action="Admin">Lịch hẹn lái thử</a>
            <a asp-controller="Admin" asp-action="Customers">Khách hàng</a>
            <a asp-controller="Admin" asp-action="Activity">Nhật ký hoạt động</a>
        </nav>
        <div class="sidebar-bottom"><span class="badge">ADMIN · TOÀN QUYỀN</span><p>@User.Identity?.Name</p>
            <a asp-controller="Staff" asp-action="ChangePassword">Đổi mật khẩu</a>
            <form asp-controller="Staff" asp-action="Logout" method="post"><button class="btn secondary" type="submit">Đăng xuất</button></form>
        </div>
    </aside>
    <main class="main">
        <header class="topbar"><span>MotoShop / Quản trị</span><span>@DateTime.Now.ToString("dd/MM/yyyy")</span></header>
        <div class="content">
            @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
            @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
            @RenderBody()
        </div>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
<script src="~/js/password-eye.js" asp-append-version="true" defer></script>
</body>
</html>
