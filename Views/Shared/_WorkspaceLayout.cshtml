@using MotoShopWeb.Security
@inject VehicleAccess Access
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ var grants = await Access.GetAsync(User); }
<!DOCTYPE html><html lang="vi"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · MotoShop Nhân viên</title>
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/password-eye.css" asp-append-version="true" />
</head><body>
<aside class="sidebar">
<a class="brand" asp-controller="Workspace" asp-action="Index">MOTO<span>SHOP</span><small>KHU LÀM VIỆC NHÂN VIÊN</small></a>
<div class="nav-label">CÔNG VIỆC</div><nav>
<a asp-controller="Workspace" asp-action="Index">Trang làm việc</a>
@if (grants.Contains(VehiclePermissions.View)) { <a asp-controller="Workspace" asp-action="Vehicles">Danh sách xe</a> }
@if (grants.Contains(VehiclePermissions.View) && grants.Contains(VehiclePermissions.Create)) { <a asp-controller="Workspace" asp-action="VehicleEdit">Thêm mẫu xe</a> }
@if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index">Trang quản trị</a> }
</nav>
<div class="sidebar-bottom"><span class="badge">@(User.IsInRole("Admin") ? "ADMIN" : "NHÂN VIÊN")</span><p>@User.Identity?.Name</p>
<a asp-controller="Staff" asp-action="ChangePassword">Đổi mật khẩu</a>
<form asp-controller="Staff" asp-action="Logout" method="post"><button class="btn secondary">Đăng xuất</button></form></div>
</aside>
<main class="main"><header class="topbar"><span>MotoShop / Nhân viên</span><span>@DateTime.Now.ToString("dd/MM/yyyy")</span></header>
<div class="content">
@if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@RenderBody()
</div></main>
<script src="~/js/password-eye.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
