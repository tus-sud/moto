@model MotoShopWeb.ViewModels.StoreList
@{ViewData["Title"]="Đam mê trên từng cung đường";}
<section class="hero"><div class="wrap hero-inner"><div class="hero-grid"><div><p class="eyebrow">MOTOSHOP ABG / CHOOSE YOUR NEXT RIDE</p><h1>Bật đam mê.<br /><em>Mở hành trình.</em></h1><p class="intro">Từ phố thị đến những cung đường xa. Khám phá chiếc xe mang dấu ấn của riêng bạn.</p><div class="actions"><a class="button" asp-action="Vehicles">Khám phá xe ↗</a><a class="button outline" asp-controller="Customer" asp-action="Register">Tạo tài khoản</a></div></div>
<div class="showcase" aria-label="Bộ ảnh xe nổi bật"><div class="slides"><div class="road-scene" aria-hidden="true"><div class="speed-lines"><span></span><span></span><span></span><span></span><span></span></div><div class="road-asphalt"><div class="road-lane"></div></div></div><figure class="slide active"><img src="/images/catalog-abg/2026-z900-1-cutout.png" alt="Kawasaki Z900" fetchpriority="high" /><figcaption>KAWASAKI / Z900 · 948 CC</figcaption></figure><figure class="slide"><img src="/images/catalog-abg/cb1000-hornet-1-cutout.png" alt="Honda CB1000 Hornet" /><figcaption>HONDA / CB1000 HORNET · 1000 CC</figcaption></figure><figure class="slide"><img src="/images/catalog-abg/2026-ninja-zx-4rr-1.png" alt="Kawasaki Ninja ZX-4RR" /><figcaption>KAWASAKI / NINJA ZX-4RR · SPORT</figcaption></figure><figure class="slide"><img src="/images/catalog-abg/cbr1000rr-r-fireblade-sp-2024-1.png" alt="Honda CBR1000RR-R Fireblade SP" /><figcaption>HONDA / CBR1000RR-R FIREBLADE SP</figcaption></figure><figure class="slide"><img src="/images/catalog-abg/africa-twin-2026-ban-adventure-sports-1.png" alt="Honda Africa Twin Adventure Sports" /><figcaption>HONDA / AFRICA TWIN ADVENTURE</figcaption></figure></div><div class="slide-progress"><div class="slide-progress-bar" data-slide-progress></div></div><div class="slide-controls"><button type="button" data-slide-prev aria-label="Ảnh trước">←</button><span data-slide-count>01 / 05</span><button type="button" data-slide-next aria-label="Ảnh tiếp theo">→</button><button type="button" data-slide-pause aria-pressed="false">Dừng chuyển ảnh</button></div></div></div>
<div class="hero-bottom"><span>SPORT · NAKED · ADVENTURE · CRUISER</span><span>HÀNH TRÌNH BẮT ĐẦU TỪ ĐÂY</span></div></div></section>
<div class="wrap quick-links"><a asp-action="Vehicles" asp-route-q="Sport">Sport ↗</a><a asp-action="Vehicles" asp-route-q="Naked">Naked ↗</a><a asp-action="Vehicles" asp-route-q="Adventure">Adventure ↗</a><a asp-action="Vehicles" asp-route-q="Cruiser">Cruiser ↗</a><a asp-action="Vehicles" asp-route-budget="200000000">Dưới 200 triệu ↗</a></div>
<section class="wrap section"><div class="section-title"><div><p class="eyebrow">TÌM NGƯỜI BẠN ĐỒNG HÀNH</p><h2>Những lựa chọn mới</h2></div><a asp-action="Vehicles">Toàn bộ danh mục (@Model.Total) →</a></div><partial name="_StoreCards" model="Model" /></section>
<section class="feature-band"><div class="wrap about-grid"><img src="/images/catalog-abg/africa-twin-2026-ban-adventure-sports-1.png" alt="Honda Africa Twin Adventure Sports" loading="lazy" /><div><p class="eyebrow">VƯỢT QUA NHỮNG GIỚI HẠN QUEN THUỘC</p><h2>Đi xa hơn.<br />Khám phá nhiều hơn.</h2><p>Tìm hiểu các mẫu xe adventure và touring cho những chuyến đi dài.</p><a class="button" asp-action="Vehicles" asp-route-q="Adventure">Khám phá Adventure ↗</a></div></div></section>
<section id="about" class="wrap section"><div class="section-title"><div><p class="eyebrow">MUA XE TẠI MOTOSHOPABG</p><h2>Rõ từng bước. Trọn đam mê.</h2></div><a asp-controller="Orders" asp-action="Index">Theo dõi đơn của bạn →</a></div><div class="grid steps-grid"><article><b>01 / KHÁM PHÁ</b><h3>Chọn chiếc xe</h3><p>Lọc theo hãng, giá và xem ảnh cùng thông số của từng mẫu.</p></article><article><b>02 / GỬI YÊU CẦU</b><h3>Chọn màu, để lại liên hệ</h3><p>Đăng nhập và gửi danh sách xe bạn quan tâm đến cửa hàng.</p></article><article><b>03 / XÁC NHẬN</b><h3>Hoàn thiện lựa chọn</h3><p>Cửa hàng xác nhận tình trạng xe, giá và phương thức giao nhận.</p></article></div>
<div class="faq"><h2>Trước khi bắt đầu</h2><details><summary>Giá trên website đã là giá lăn bánh chưa?</summary><p>Chưa. Đây là giá xe tham khảo/niêm yết, chưa gồm phí đăng ký và giao xe. Cửa hàng sẽ báo giá cuối cùng khi liên hệ.</p></details><details><summary>Gửi yêu cầu có phải trả tiền ngay không?</summary><p>Không. Website hiện tiếp nhận yêu cầu mua xe, chưa tích hợp thanh toán trực tuyến và chưa giữ tồn kho tự động.</p></details><details><summary>Tôi xem đơn đã gửi ở đâu?</summary><p>Đăng nhập tài khoản khách hàng và chọn “Đơn của tôi” trên thanh menu.</p></details></div></section>
