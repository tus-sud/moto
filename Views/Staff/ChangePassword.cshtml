@model PasswordForm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h1>Đổi mật khẩu</h1><p class="muted">Mật khẩu mới cần 12–128 ký tự, có chữ hoa, chữ thường và số.</p>
<form asp-controller="Staff" asp-action="ChangePassword" method="post">
<div asp-validation-summary="All"></div>
<div class="field"><label asp-for="CurrentPassword">Mật khẩu hiện tại / mật khẩu tạm</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /></div>
<div class="field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /></div>
<div class="field"><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></div>
<button class="btn" type="submit">Lưu mật khẩu mới</button></form>
<a class="btn secondary" asp-controller="Workspace" asp-action="Index">Quay lại</a>
<form asp-controller="Staff" asp-action="Logout" method="post"><button class="btn secondary">Đăng xuất</button></form>
