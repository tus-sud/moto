@model List<MotoShopWeb.Models.LichLaiThu>
@using MotoShopWeb.ViewModels
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý lịch lái thử";
}
<div class="heading">
    <div>
        <h1>Lịch hẹn lái thử xe</h1>
        <p>Tiếp nhận và xác nhận lịch hẹn trải nghiệm xe của khách hàng tại showroom.</p>
    </div>
</div>

<div class="panel flush">
    @if (Model.Count == 0)
    {
        <div class="empty">Chưa có lịch hẹn lái thử nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách hàng</th>
                        <th>Mẫu xe</th>
                        <th>Thời gian hẹn</th>
                        <th>Ghi chú</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.MaLich</strong></td>
                            <td>
                                <strong>@item.MaKhNavigation.HoTen</strong>
                                <small>@item.MaKhNavigation.Email @(string.IsNullOrEmpty(item.MaKhNavigation.SoDienThoai) ? "" : "· " + item.MaKhNavigation.SoDienThoai)</small>
                            </td>
                            <td><strong>@item.MaXeNavigation.TenXe</strong></td>
                            <td>@item.NgayHen.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="detail">@(item.GhiChu ?? "—")</td>
                            <td><span class="badge @(item.TrangThai == "DaHuy" ? "off" : "")">@OrderLabels.Name(item.TrangThai)</span></td>
                            <td>
                                <div class="actions">
                                    @if (item.TrangThai == "ChoXacNhan")
                                    {
                                        <form asp-action="AdminUpdate" method="post">
                                            <input type="hidden" name="id" value="@item.MaLich" />
                                            <input type="hidden" name="status" value="DaXacNhan" />
                                            <button class="btn small" type="submit">Xác nhận</button>
                                        </form>
                                        <form asp-action="AdminUpdate" method="post">
                                            <input type="hidden" name="id" value="@item.MaLich" />
                                            <input type="hidden" name="status" value="DaHuy" />
                                            <button class="btn small danger" type="submit">Hủy</button>
                                        </form>
                                    }
                                    else if (item.TrangThai == "DaXacNhan")
                                    {
                                        <form asp-action="AdminUpdate" method="post">
                                            <input type="hidden" name="id" value="@item.MaLich" />
                                            <input type="hidden" name="status" value="HoanThanh" />
                                            <button class="btn small" type="submit">Hoàn thành</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

