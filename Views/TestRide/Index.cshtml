@model List<MotoShopWeb.Models.LichLaiThu>
@using MotoShopWeb.ViewModels
@{ ViewData["Title"] = "Lịch hẹn lái thử"; }
<section class="wrap section">
    <p class="eyebrow">TRẢI NGHIỆM THỰC TẾ</p>
    <div class="section-title">
        <h1 class="page-title" style="margin:0">Lịch hẹn lái thử của tôi</h1>
        <a asp-controller="Home" asp-action="Vehicles">Chọn xe đặt lịch mới →</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">
            <h3>Chưa có lịch hẹn lái thử</h3>
            <p>Hãy mở trang chi tiết mẫu xe bạn yêu thích và chọn khung giờ hẹn lái thử tại showroom.</p>
            <a class="button" asp-controller="Home" asp-action="Vehicles">Khám phá xe →</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <article class="cart-line">
                <div>
                    <p class="eyebrow">LỊCH HẸN #@item.MaLich · NGÀY HẸN: @item.NgayHen.ToString("dd/MM/yyyy HH:mm")</p>
                    <h3>
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.MaXe">
                            @item.MaXeNavigation.MaHangNavigation?.TenHang @item.MaXeNavigation.TenXe
                        </a>
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                    {
                        <p class="muted" style="margin:4px 0">Ghi chú: @item.GhiChu</p>
                    }
                    <span class="badge">@OrderLabels.Name(item.TrangThai)</span>
                </div>
                <div class="actions">
                    @if (item.TrangThai == "ChoXacNhan")
                    {
                        <form asp-action="Cancel" method="post" style="margin:0">
                            <input type="hidden" name="id" value="@item.MaLich" />
                            <button type="submit" class="button" style="background:#fff0ee;color:#9d2020;border:1px solid #f2c4bc">Hủy lịch hẹn</button>
                        </form>
                    }
                    <a class="button" asp-controller="Home" asp-action="Details" asp-route-id="@item.MaXe">Xem xe →</a>
                </div>
            </article>
        }
    }
</section>

